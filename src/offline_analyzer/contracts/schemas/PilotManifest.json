{
  "$defs": {
    "JsonValue": {},
    "PilotDataset": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "maxLength": 100,
          "title": "Domain",
          "type": "string"
        },
        "dataset": {
          "maxLength": 200,
          "title": "Dataset",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUCCESS",
            "EMPTY",
            "FAILED"
          ],
          "title": "Status",
          "type": "string"
        },
        "record_count": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Count"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "started_utc": {
          "format": "date-time",
          "title": "Started Utc",
          "type": "string"
        },
        "finished_utc": {
          "format": "date-time",
          "title": "Finished Utc",
          "type": "string"
        },
        "file": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "error_file": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error File"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "maxLength": 16000,
          "title": "Command"
        }
      },
      "required": [
        "domain",
        "dataset",
        "status",
        "exit_code",
        "started_utc",
        "finished_utc",
        "command"
      ],
      "title": "PilotDataset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "pilot-1.2.2",
      "title": "Schema Version",
      "type": "string"
    },
    "collector": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ],
      "title": "Collector"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
      "title": "Project Id",
      "type": "string"
    },
    "project_name": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Name"
    },
    "collected_utc": {
      "format": "date-time",
      "title": "Collected Utc",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/JsonValue"
    },
    "limitations": {
      "$ref": "#/$defs/JsonValue"
    },
    "datasets": {
      "items": {
        "$ref": "#/$defs/PilotDataset"
      },
      "maxItems": 1024,
      "minItems": 1,
      "title": "Datasets",
      "type": "array"
    },
    "dataset_origin": {
      "default": "tool-generated",
      "enum": [
        "synthetic",
        "tool-generated"
      ],
      "title": "Dataset Origin",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "collector",
    "project_id",
    "collected_utc",
    "scope",
    "limitations",
    "datasets"
  ],
  "title": "PilotManifest",
  "type": "object"
}