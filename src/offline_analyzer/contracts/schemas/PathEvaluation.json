{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "artifact_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "path_definition_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Path Definition Id",
      "type": "string"
    },
    "definition_version": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Definition Version",
      "type": "string"
    },
    "run_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "state": {
