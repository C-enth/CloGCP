      "type": "string"
    },
    "relationship_ids": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "title": "Relationship Ids",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "prerequisites": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "title": "Prerequisites",
      "type": "array"
    },
    "blockers": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "missing_dependencies": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "title": "Missing Dependencies",
      "type": "array"
    },
    "reasoning": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Reasoning",
      "type": "string"
    },
    "limitations": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "assessed_at": {
      "format": "date-time",
      "title": "Assessed At",
      "type": "string"
    }
  },
  "required": [
    "path_definition_id",
    "definition_version",
    "run_id",
    "state",
    "relationship_ids",
    "evidence",
    "prerequisites",
    "blockers",
    "missing_dependencies",
    "reasoning",
    "limitations",
    "assessed_at"
