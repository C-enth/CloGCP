        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "project_number": {
      "anyOf": [
        {
          "pattern": "^[0-9]{1,20}$",
          "type": "string"
        },
        {
          "type": "null"
        }
