  "required": [
    "observation_id",
    "account_id",
    "region",
    "resource_id",
    "native_id",
    "resource_type",
    "partition",
    "source_tool",
    "source_version",
    "source_check_id",
    "source_status",
    "source_severity",
    "collected_at",
    "operation",
    "configuration",
    "evidence",
