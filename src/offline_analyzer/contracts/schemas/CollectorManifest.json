{
  "$defs": {
    "Collector": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "Collector",
      "type": "object"
    },
    "JsonValue": {},
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "pattern": "^[a-z0-9-]{2,40}:[A-Za-z0-9]{2,80}$",
          "title": "Operation",
          "type": "string"
        },
        "region": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Region",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "SKIPPED"
          ],
          "title": "Status",
          "type": "string"
        },
        "format": {
          "default": "aws-json-v1",
          "enum": [
            "aws-json-v1",
            "prowler-ocsf-5.10",
            "prowler-ocsf-5.26.1"
          ],
          "title": "Format",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "pages": {
          "default": 0,
          "maximum": 100000,
          "minimum": 0,
          "title": "Pages",
          "type": "integer"
        },
        "pagination": {
          "default": "NOT_PAGINATED",
          "enum": [
            "NOT_PAGINATED",
            "ALL_PAGES_MERGED",
            "TRUNCATED"
          ],
          "title": "Pagination",
          "type": "string"
        },
        "request_parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "default": {},
          "title": "Request Parameters",
          "type": "object"
        },
        "error_code": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9.:_-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "tool_version": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "required": [
        "operation",
        "region",
        "status",
        "started_at",
        "completed_at"
      ],
      "title": "Operation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "closec-collector-1",
      "title": "Schema",
      "type": "string"
    },
    "package_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Package Id",
      "type": "string"
    },
    "collector": {
      "$ref": "#/$defs/Collector"
    },
    "account_id": {
      "pattern": "^[0-9]{12}$",
      "title": "Account Id",
      "type": "string"
    },
    "partition": {
      "default": "aws",
      "enum": [
        "aws",
        "aws-cn",
        "aws-us-gov"
      ],
      "title": "Partition",
      "type": "string"
    },
    "dataset_origin": {
      "anyOf": [
        {
          "enum": [
            "SYNTHETIC",
            "TOOL_GENERATED"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Origin"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "regions": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Regions",
      "type": "array"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/Operation"
      },
      "maxItems": 20000,
      "minItems": 1,
      "title": "Operations",
      "type": "array"
    }
  },
  "required": [
    "schema",
    "package_id",
    "collector",
    "account_id",
    "started_at",
    "completed_at",
    "regions",
    "operations"
  ],
  "title": "CollectorManifest",
  "type": "object"
}